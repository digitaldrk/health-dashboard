# Optional overrides. `docker compose up --build` works without copying this file.

POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare
POSTGRES_DB=healthcare

# Used when the API runs on the host, outside Compose.
DATABASE_URL=postgresql+psycopg://healthcare:healthcare@localhost:5433/healthcare
FRONTEND_ORIGIN=http://localhost:5173
SEED_ON_STARTUP=true
RUN_MIGRATIONS=true

# Vite proxy target for `npm run dev` on the host.
API_PROXY_TARGET=http://localhost:8000
